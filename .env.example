# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
EXPO_PUBLIC_KAKAO_JS_KEY=
# 콘솔 > 플랫폼 > Web 에 등록한 사이트 도메인
EXPO_PUBLIC_KAKAO_SITE_DOMAIN=http://localhost:8081

# --- 데이터 적재용 (앱 번들에 들어가지 않음) ---
# https://data.seoul.go.kr 마이페이지 > 인증키 신청
SEOUL_API_KEY=
# https://www.vworld.kr 오픈API 인증키 (주소 -> 좌표, 법정동코드)
VWORLD_API_KEY=
# https://www.data.go.kr/data/15134735/openapi.do 활용신청 후 서비스키
DATA_GO_KR_SERVICE_KEY=
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 앱에서 쓰는 값 ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
